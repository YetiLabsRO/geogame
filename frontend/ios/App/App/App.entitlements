<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
	</array>
	<!--
		Not set up in this environment (no Xcode/Mac available) — add these in the Xcode
		target's Signing & Capabilities tab, which will populate them here automatically:

		- Associated Domains (needed for applinks:cercetador.albascout.ro universal links):
			<key>com.apple.developer.associated-domains</key>
			<array>
				<string>applinks:cercetador.albascout.ro</string>
			</array>

		- Push Notifications:
			<key>aps-environment</key>
			<string>development</string> (or "production" for release builds)

		See docs/mobile.md for the full iOS setup steps.
	-->
</dict>
</plist>
