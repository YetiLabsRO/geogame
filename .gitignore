
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


venv/*
.idea/*
media/*
.env
.envrc
dump*sql
# Database dumps carry production data, including real people's names.
# They belong on the machine doing the import, never in git history.
# (Deliberately not a bare `*.sql`, so a hand-written script can still
# be tracked.)
*.dump
*.sql.gz
geogame/local_settings*.py
cercetador/local_settings*

# Claude Code — local/private state
.claude/settings.local.json
.claude/worktrees/

# VS Code — user-local state (keep launch.json, settings.json, tasks.json tracked)
.vscode/*.log

# Test / coverage artifacts
.coverage
coverage.xml
htmlcov/

# Django collectstatic output
staticfiles/

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/tmp/
