{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: Django (runserver)",
      "type": "shell",
      "command": "/home/yeti/.virtualenvs/cercetador/bin/python manage.py runserver 8200",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "DJANGO_SETTINGS_MODULE": "geogame.settings"
        }
      },
      "isBackground": true,
      "presentation": {
        "group": "run",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "django",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Watching for file changes.*|.*Performing system checks.*",
          "endsPattern": ".*Quit the server with.*|.*Starting development server at.*"
        }
      }
    },
    {
      "label": "Run: player SPA (ng serve :4500)",
      "type": "shell",
      "command": "npx ng serve player --port 4500",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "group": "run",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "ng-player",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Building\\.\\.\\.|Application bundle generation|Changes detected|Watch mode).*",
          "endsPattern": ".*(Local:|Watch mode enabled|Application bundle generation complete).*"
        }
      }
    },
    {
      "label": "Run: staff SPA (ng serve :4501)",
      "type": "shell",
      "command": "npx ng serve staff --port 4501",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "presentation": {
        "group": "run",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "ng-staff",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(Building\\.\\.\\.|Application bundle generation|Changes detected|Watch mode).*",
          "endsPattern": ".*(Local:|Watch mode enabled|Application bundle generation complete).*"
        }
      }
    },
    {
      "label": "Run: full stack (Django + player + staff)",
      "dependsOn": [
        "Run: Django (runserver)",
        "Run: player SPA (ng serve :4500)",
        "Run: staff SPA (ng serve :4501)"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Django: migrate",
      "type": "shell",
      "command": "/home/yeti/.virtualenvs/cercetador/bin/python manage.py migrate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Django: makemigrations",
      "type": "shell",
      "command": "/home/yeti/.virtualenvs/cercetador/bin/python manage.py makemigrations",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Django: test",
      "type": "shell",
      "command": "/home/yeti/.virtualenvs/cercetador/bin/python manage.py test --verbosity=2 --noinput",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
